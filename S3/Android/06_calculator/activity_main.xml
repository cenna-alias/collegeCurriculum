<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    android:padding="5dp">

    <TextView
        android:id="@+id/expression"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:gravity="center|end"
        android:padding="10dp"
        android:text=""
        android:textColor="#777777"
        android:textSize="22sp"
        android:maxLines="1" />

    <TextView
        android:id="@+id/display"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:gravity="center|end"
        android:padding="10dp"
        android:text="0"
        android:textColor="#FFFFFF"
        android:textSize="48sp"
        android:maxLines="1" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center">

        <Button
            android:id="@+id/clear"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="AC"
            android:textSize="13sp" />

        <Button
            android:id="@+id/backspace"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="⌫"
            android:textSize="17sp" />

        <Button
            android:id="@+id/percent"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="%"
            android:textSize="15sp" />

        <Button
            android:id="@+id/div"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="÷"
            android:textSize="18sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center">

        <Button
            android:id="@+id/b7"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="7"
            android:textSize="18sp" />

        <Button
            android:id="@+id/b8"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="8"
            android:textSize="18sp" />

        <Button
            android:id="@+id/b9"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="9"
            android:textSize="18sp" />

        <Button
            android:id="@+id/mul"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="×"
            android:textSize="18sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center">

        <Button
            android:id="@+id/b4"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="4"
            android:textSize="18sp" />

        <Button
            android:id="@+id/b5"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="5"
            android:textSize="18sp" />

        <Button
            android:id="@+id/b6"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="6"
            android:textSize="18sp" />

        <Button
            android:id="@+id/sub"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="-"
            android:textSize="18sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center">

        <Button
            android:id="@+id/b1"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="1"
            android:textSize="18sp" />

        <Button
            android:id="@+id/b2"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="2"
            android:textSize="18sp" />

        <Button
            android:id="@+id/b3"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="3"
            android:textSize="18sp" />

        <Button
            android:id="@+id/add"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="+"
            android:textSize="18sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center">

        <Button
            android:id="@+id/b0"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="2"
            android:layout_margin="2dp"
            android:text="0"
            android:textSize="18sp" />

        <Button
            android:id="@+id/dot"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="."
            android:textSize="18sp" />

        <Button
            android:id="@+id/equal"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="="
            android:textSize="18sp" />

    </LinearLayout>

</LinearLayout>
