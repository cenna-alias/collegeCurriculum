<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="25dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Indian Leaders"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#222222"
        android:layout_marginBottom="25dp" />

    <ImageView
        android:id="@+id/imgLogo1"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:src="@drawable/gandhi"
        android:contentDescription="Mahatma Gandhi"
        android:scaleType="fitCenter"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="10dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mahatma Gandhi"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="25dp" />

    <ImageView
        android:id="@+id/imgLogo2"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:src="@drawable/nehru"
        android:contentDescription="Jawaharlal Nehru"
        android:scaleType="fitCenter"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Jawaharlal Nehru"
        android:textSize="20sp"
        android:textStyle="bold" />

</LinearLayout>
